<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        :focus-visible {
            outline: 3px solid #3b82f6 !important;
            outline-offset: 2px !important;
        }

        html {
            scroll-behavior: smooth;
        }

        details>summary {
            list-style: none;
        }

        details>summary::-webkit-details-marker {
            display: none;
        }
    </style>
</head>

<body class="h-full bg-slate-50 text-slate-900 font-sans antialiased flex flex-col">

    <header
        class="w-full bg-white border-b border-slate-200 px-4 md:px-8 py-4 flex flex-col md:flex-row items-start md:items-center md:justify-start shadow-sm z-10 gap-4 md:gap-10 flex-shrink-0">
        <div class="flex items-center justify-center gap-2 w-full md:w-auto md:justify-start">
            <div class="w-8 h-8 bg-slate-800 rounded-lg flex items-center justify-center flex-shrink-0"
                aria-hidden="true">
                <span class="text-white font-bold text-xl">A</span>
            </div>
            <h1
                class="text-xl font-bold tracking-tight text-center md:text-left flex items-baseline gap-1.5 whitespace-nowrap">
                A11yAudit <span class="text-slate-500 font-normal text-sm md:text-xl hidden md:block">| Project
                    Dashboard</span>
            </h1>
        </div>
        <nav aria-label="Main Navigation" class="w-full md:w-auto mt-2 md:mt-0">
            <ul class="flex gap-4 md:gap-6 text-sm font-medium text-slate-600 justify-start flex-wrap">
                <li><a href="/" class="hover:text-blue-600 transition-colors py-2">Snippet Sandbox</a></li>
                <li><a href="/dashboard" class="text-slate-900 border-b-2 border-slate-900 pb-1 py-2">Full Project
                        Dashboard</a></li>
            </ul>
        </nav>
    </header>

    <main class="flex-grow flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
        <aside
            class="w-full lg:w-1/3 lg:max-w-sm bg-white border-b lg:border-b-0 lg:border-r border-slate-200 p-4 md:p-6 flex flex-col gap-6 lg:overflow-y-auto flex-shrink-0">
            <div>
                <h2 class="font-bold text-lg mb-1">New Audit</h2>
                <p class="text-sm text-slate-500 mb-4">Analyze a single live page or upload up to 10 HTML files.</p>
            </div>
            <form id="dashboard-audit-form" class="space-y-6">
                <div>
                    <label for="url-input" class="block text-sm font-medium text-slate-700 mb-1">Single Live Page
                        URL</label>
                    <input type="url" id="url-input" name="userInput" placeholder="https://example.com"
                        class="w-full p-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 text-sm">
                </div>
                <div class="flex items-center" aria-hidden="true">
                    <div class="flex-grow border-t border-slate-200"></div>
                    <span class="mx-3 text-xs text-slate-400 font-bold uppercase">OR</span>
                    <div class="flex-grow border-t border-slate-200"></div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">HTML Files (Max 10)</label>
                    <div
                        class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center hover:bg-slate-50 transition-colors focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-transparent">
                        <label for="file-upload" class="cursor-pointer block">
                            <span class="text-blue-600 font-medium text-sm block md:inline">Browse files</span>
                            <span class="text-slate-500 text-sm block md:inline"> or drag and drop</span>
                            <input type="file" id="file-upload" class="sr-only" accept=".html" multiple>
                        </label>
                        <p id="file-name" class="text-xs text-slate-600 font-medium mt-2 break-all" aria-live="polite">
                        </p>
                    </div>
                </div>
                <button type="submit" id="submit-btn"
                    class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3 md:py-2.5 rounded-lg font-medium transition-colors shadow-sm focus:ring-4 focus:ring-slate-200">
                    Run Project Audit
                </button>
            </form>
        </aside>

        <section class="flex-grow bg-slate-50 p-4 md:p-8 lg:overflow-y-auto" id="results-pane">
            <div class="max-w-3xl mx-auto flex flex-col items-center justify-center h-full text-slate-400 text-center py-12 lg:py-0"
                id="empty-state">
                <i class="fa-regular fa-file-lines text-6xl mb-4 opacity-30" aria-hidden="true"></i>
                <h2 class="text-xl font-medium text-slate-600">No active audit</h2>
                <p class="text-sm mt-2 max-w-xs md:max-w-none">Submit a URL or files from the sidebar to view compliance
                    reports.</p>
            </div>

            <div id="report-container" class="max-w-4xl mx-auto hidden space-y-8 pb-12 lg:pb-0">
                <div
                    class="bg-white p-4 md:p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between text-center md:text-left gap-4 md:gap-0">
                    <div>
                        <h2 class="text-lg md:text-xl font-bold text-slate-800">Project Overview</h2>
                        <p class="text-sm text-slate-500">Average score across all analyzed files.</p>
                    </div>
                    <div>
                        <p class="text-4xl md:text-5xl font-black text-slate-800" id="aggregate-score-display">--</p>
                    </div>
                </div>

                <div id="file-reports-container" class="space-y-6" aria-live="polite"></div>
            </div>
        </section>
    </main>

    <script>
        const form = document.getElementById('dashboard-audit-form');
        const fileInput = document.getElementById('file-upload');
        const urlInputEl = document.getElementById('url-input');
        const fileNameDisplay = document.getElementById('file-name');
        const btn = document.getElementById('submit-btn');

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length === 1) fileNameDisplay.textContent = fileInput.files[0].name;
            else if (fileInput.files.length > 1) fileNameDisplay.textContent = `${fileInput.files.length} files selected`;
            else fileNameDisplay.textContent = "";
        });

        function escapeHTML(str) { return str.replace(/[&<>"']/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m]; }); }
        function getScoreColor(score) { if (score >= 90) return 'text-green-600'; if (score >= 70) return 'text-yellow-600'; return 'text-red-600'; }

        // FontAwesome Icon mapper for disability tags
        function getDisabilityIcon(type) {
            const t = type.toLowerCase();
            if (t.includes('blind') && !t.includes('deafblind')) return `<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>`;
            if (t.includes('mobility') || t.includes('motor')) return `<i class="fa-regular fa-hand-paper" aria-hidden="true"></i>`;
            if (t.includes('cognitive')) return `<i class="fa-solid fa-brain" aria-hidden="true"></i>`;
            if (t.includes('hearing') || t.includes('deaf') && !t.includes('deafblind')) return `<i class="fa-regular fa-ear-deaf" aria-hidden="true"></i>`;
            if (t.includes('vision')) return `<i class="fa-regular fa-eye" aria-hidden="true"></i>`;
            if (t.includes('deafblind')) return `<i class="fa-solid fa-universal-access" aria-hidden="true"></i>`;

            // Unknown / Default
            return `<i class="fa-regular fa-circle-question" aria-hidden="true"></i>`;
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!urlInputEl.value && fileInput.files.length === 0) return alert("Provide a URL or files.");
            if (fileInput.files.length > 10) return alert("Max 10 files.");

            document.getElementById('empty-state').classList.add('hidden');
            document.getElementById('report-container').classList.add('hidden');
            btn.textContent = "Analyzing..."; btn.disabled = true;

            const formData = new FormData();
            if (urlInputEl.value) formData.append('userInput', urlInputEl.value);
            for (let i = 0; i < fileInput.files.length; i++) formData.append('auditFiles', fileInput.files[i]);

            urlInputEl.value = ''; form.reset(); fileNameDisplay.textContent = "";

            try {
                const response = await fetch('/run-audit', { method: 'POST', body: formData });
                const data = await response.json();

                if (data.error) return alert(data.error);

                document.getElementById('aggregate-score-display').textContent = data.aggregateScore + '%';
                document.getElementById('aggregate-score-display').className = `text-4xl md:text-5xl font-black ${getScoreColor(data.aggregateScore)}`;

                const container = document.getElementById('file-reports-container');
                container.innerHTML = "";

                data.files.forEach(fileReport => {
                    let violationsHTML = "";
                    if (fileReport.violations.length === 0) {
                        violationsHTML = `<div class="p-6 text-center text-green-600 font-medium"><i class="fa-solid fa-check-circle mr-2"></i>Perfect score! No accessibility barriers detected.</div>`;
                    } else {
                        fileReport.violations.forEach(issue => {

                            // 1. Build the IDE-style code snippets with exact line numbers
                            const instancesHTML = issue.nodes.map(node => `
                                <div class="flex text-[12px] font-mono bg-slate-900 py-2 rounded">
                                    <div aria-hidden="true" class="text-slate-500 px-2 text-right select-none border-r border-slate-700 min-w-[2.5rem] flex-shrink-0">
                                        ${node.lineNumber}
                                    </div>
                                    <code class="text-blue-300 px-2 overflow-x-auto flex-grow block">
                                        ${escapeHTML(node.html)}
                                    </code>
                                </div>
                            `).join('');

                            // 2. Build the disabilities layout block using FontAwesome
                            const hasDisabilities = issue.disabilities && issue.disabilities.length > 0 && issue.disabilities[0] !== 'Unknown';
                            let disabilitiesHTML = '';

                            if (hasDisabilities) {
                                const listItems = issue.disabilities.map(d => `
                                    <li class="flex items-center gap-1.5 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-full">
                                        <span aria-hidden="true" class="text-blue-600">${getDisabilityIcon(d)}</span>
                                        ${d}
                                    </li>
                                `).join('');

                                disabilitiesHTML = `
                                    <div class="mb-5 bg-white border border-slate-200 rounded-lg p-4">
                                        <h5 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Affected Groups:</h5>
                                        <ul class="flex flex-wrap gap-2">
                                            ${listItems}
                                        </ul>
                                    </div>
                                `;
                            }

                            // 3. Wrap the whole error block in a collapsible <details> tag
                            violationsHTML += `
                                <details class="group border-t border-slate-200 open:bg-slate-50/50 transition-colors">
                                    <summary class="p-4 md:p-6 cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4 md:gap-0 hover:bg-slate-50 focus-visible:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500">
                                        <div class="flex items-start md:items-center gap-3">
                                            <div class="text-slate-400 group-open:rotate-90 transition-transform duration-200 flex-shrink-0 mt-0.5 md:mt-0">
                                                <i class="fa-solid fa-chevron-right text-sm" aria-hidden="true"></i>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-slate-900 text-sm md:text-base">${issue.help}</h4>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="text-[10px] md:text-xs font-bold px-2 py-0.5 rounded uppercase ${issue.impact === 'critical' ? 'bg-red-100 text-red-700' : issue.impact === 'serious' ? 'bg-orange-100 text-orange-700' : issue.impact === 'moderate' ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700'}">${issue.impact}</span>
                                                    <span class="text-slate-500 text-[10px] md:text-xs font-medium">${issue.nodes.length} instance(s)</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex flex-wrap gap-2 md:justify-end ml-9 md:ml-0">
                                            ${issue.tags.slice(0, 3).map(tag => `<span class="text-[9px] bg-slate-200 text-slate-700 px-2 py-1 rounded font-bold uppercase">${tag}</span>`).join('')}
                                        </div>
                                    </summary>
                                    
                                    <div class="p-4 md:p-6 pt-0 ml-0 md:ml-9">
                                        <p class="text-sm text-slate-600 mb-5 leading-relaxed">${issue.description}</p>
                                        
                                        <!-- Injected Disabilities Block -->
                                        ${disabilitiesHTML}
                                        
                                        <div class="mb-4">
                                            <h5 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Affected Code:</h5>

                                            <div class="py-2 flex flex-col gap-2">
                                                ${instancesHTML}
                                            </div>
                                            
                                        </div>

                                        <div class="flex justify-start md:justify-end mt-4">
                                            <a href="${issue.helpUrl}" target="_blank" class="text-sm text-blue-600 hover:text-blue-800 font-bold inline-flex items-center gap-1 hover:underline">
                                                View Remediation Strategy 
                                                <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-1" aria-hidden="true"></i>
                                            </a>
                                        </div>
                                    </div>
                                </details>
                            `;
                        });
                    }

                    container.innerHTML += `
                        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
                            <div class="px-4 md:px-6 py-4 bg-slate-50 border-b border-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 md:gap-0">
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base md:text-lg break-all"><i class="fa-regular fa-file-code mr-2 text-slate-400"></i>${fileReport.sourceFile}</h3>
                                    <p class="text-xs text-slate-500 font-medium mt-1">Scanned ${fileReport.totalElements} DOM elements</p>
                                </div>
                                <div class="text-left md:text-right w-full md:w-auto flex flex-row md:flex-col justify-between md:justify-start items-center md:items-end">
                                    <p class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-wider mb-0 md:mb-1">File Health</p>
                                    <p class="text-xl md:text-2xl font-black ${getScoreColor(fileReport.score)}">${fileReport.score}%</p>
                                </div>
                            </div>
                            <div class="flex flex-col">
                                ${violationsHTML}
                            </div>
                        </div>
                    `;
                });

                document.getElementById('report-container').classList.remove('hidden');
                if (window.innerWidth < 1024) setTimeout(() => document.getElementById('results-pane').scrollIntoView({ behavior: 'smooth' }), 100);
            } catch (err) { alert("Error during audit."); console.error(err); }
            finally { btn.textContent = "Run Project Audit"; btn.disabled = false; }
        });
    </script>
</body>

</html>